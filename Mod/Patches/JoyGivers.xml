<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Add recreation only when the building has no provider. Preserve existing job definitions and upstream fixes. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="NSTRDamHaji"][not(/Defs/JoyGiverDef/thingDefs/li[text()="NSTRDamHaji"])]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/JobDef[defName="MalayFix_Play_DamHaji"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <JobDef>
                <defName>MalayFix_Play_DamHaji</defName>
                <driverClass>JobDriver_SitFacingBuilding</driverClass>
                <reportString>playing dam haji.</reportString>
                <joyDuration>4000</joyDuration>
                <joyMaxParticipants>2</joyMaxParticipants>
                <joySkill>Intellectual</joySkill>
                <joyXpPerTick>0.002</joyXpPerTick>
                <joyKind>Gaming_Cerebral</joyKind>
              </JobDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <JoyGiverDef>
              <defName>MalayFix_Play_DamHaji</defName>
              <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
              <baseChance>2</baseChance>
              <requireChair>false</requireChair>
              <thingDefs>
                <li>NSTRDamHaji</li>
              </thingDefs>
              <jobDef>MalayFix_Play_DamHaji</jobDef>
              <joyKind>Gaming_Cerebral</joyKind>
              <requiredCapacities>
                <li>Sight</li>
                <li>Manipulation</li>
              </requiredCapacities>
            </JoyGiverDef>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="NSTRWeaveSpot"][not(/Defs/JoyGiverDef/thingDefs/li[text()="NSTRWeaveSpot"])]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/JobDef[defName="MalayFix_Weave"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
              <JobDef>
                <defName>MalayFix_Weave</defName>
                <driverClass>JobDriver_WatchBuilding</driverClass>
                <reportString>weaving at TargetA.</reportString>
                <joyDuration>4000</joyDuration>
                <joyMaxParticipants>1</joyMaxParticipants>
                <joySkill>Artistic</joySkill>
                <joyXpPerTick>0.002</joyXpPerTick>
                <joyKind>NSTRMade_Weave</joyKind>
              </JobDef>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <JoyGiverDef>
              <defName>MalayFix_Weave</defName>
              <giverClass>JoyGiver_InteractBuildingInteractionCell</giverClass>
              <baseChance>2</baseChance>
              <requireChair>false</requireChair>
              <thingDefs>
                <li>NSTRWeaveSpot</li>
              </thingDefs>
              <jobDef>MalayFix_Weave</jobDef>
              <joyKind>NSTRMade_Weave</joyKind>
              <requiredCapacities>
                <li>Sight</li>
                <li>Manipulation</li>
              </requiredCapacities>
            </JoyGiverDef>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>